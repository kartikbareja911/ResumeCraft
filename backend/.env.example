# --- MongoDB ---
# Leave empty to automatically use the local db.json fallback.
# Set to "false" to force the db.json fallback even when a URI is present.
MONGODB_URI=

# --- Security ---
# REQUIRED in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- HTTP ---
# Port for the Express server
PORT=5000

# --- Deployment ---
# "production" enables security headers, request logging, SPA static serving
NODE_ENV=development

# Comma-separated allowlist of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Set to "true" when running behind a reverse proxy so rate limiting sees real client IPs
TRUST_PROXY=false

# --- Gemini AI (ATS Scoring) ---
# Get a free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model to use (gemini-1.5-flash-latest is the correct v1beta model name)
GEMINI_MODEL=gemini-2.0-flash-lite
